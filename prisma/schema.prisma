generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String @id @default(uuid())
  username       String @unique
  hashedPassword String
}

model Song {
  id           String   @id
  title        String
  duration     Int
  channelName  String
  thumbnailURL String
  diskPath     String
  url          String
  uploadDate   DateTime @default(now())
}
