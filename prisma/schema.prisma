generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Song {
  id                Int        @id @default(autoincrement())
  videoId           String     @unique
  title             String
  durationSeconds   Int        @default(0)
  durationTimestamp  String     @default("0:00")
  filePath          String
  thumbnail         String?
  status            SongStatus @default(downloaded)
  downloadedAt      DateTime?
  lastListenedAt    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("songs")
}

enum SongStatus {
  downloaded
  notDownloaded
}