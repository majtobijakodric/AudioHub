generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String @id @default(uuid())
  username       String @unique
  hashedPassword String
  playlists      Playlist[] // one user can have many playlists
}

model Song {
  id           String   @id
  title        String
  duration     Int
  channelName  String
  thumbnailURL String
  diskPath     String
  url          String
  uploadDate   DateTime @default(now())
  createdAt    DateTime @default(now()) // for sorting songs by upload date
  playlists    Playlist[] @relation("PlaylistSongs")
}

model Playlist {
  id     String @id @default(uuid())
  name   String
  userId String
  createdAt DateTime @default(now()) // for sorting playlists by creation date
  user   User   @relation(fields: [userId], references: [id])
  songs  Song[] @relation("PlaylistSongs") 
}
