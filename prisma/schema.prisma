generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String     @id @default(uuid())
  username       String     @unique
  hashedPassword String
  playlists      Playlist[] // one user can have many playlists
  songs          UserSong[]
}

model Song {
  id           String   @id
  title        String
  duration     Int
  channelName  String
  thumbnailURL String
  diskPath     String
  url          String
  createdAt    DateTime @default(now()) // for sorting songs by upload date

  userSongs UserSong[]
  playlists Playlist[] @relation("PlaylistSongs")
}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now()) // for sorting playlists by creation date
  user      User     @relation(fields: [userId], references: [id])
  songs     Song[]   @relation("PlaylistSongs")
}

model UserSong {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
}
