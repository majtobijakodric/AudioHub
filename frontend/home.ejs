<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AudioHub - home</title>
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
    <link rel="icon" href="assets/favicon.svg" type="image/svg+xml" />
</head>

<body class="min-h-screen w-full bg-black text-amber-50">
    <!-- this div is for the bg shadow effect when you open a menu -->
    <!-- add classes to it in js -->
    <div id="mainDiv" class="min-h-screen w-full grid grid-rows-[5rem_1fr_5rem]">

        <!-- user menu -->
        <div id="userMenu" class="fixed hidden z-100 w-screen h-screen">
            <div class="flex items-center justify-center w-full h-full bg-black/60 border-0">
                <div
                    class="border-0 relative z-10 rounded-lg p-6 bg-[#181818] flex flex-col gap-1 justify-center h-120 w-80 ">

                    <p id="username" class="mt-4 mb-auto text-center text-xl font-bold"></p>

                    <div class="flex w-full flex-col gap-3">
                        <button id="removeSongsButton" type="button"
                            class="cursor-pointer hover:bg-[#27B556] bg-[#27B556]/80 transition-colors delay-100 border-0 rounded-4xl p-2 pl-10 pr-10 font-bold">Remove
                            Songs</button>
                        <button id="removePlaylistsButton" type="button"
                            class="cursor-pointer hover:bg-[#27B556] bg-[#27B556]/80 transition-colors delay-100 border-0 rounded-4xl p-2 pl-10 pr-10 font-bold">Remove
                            Playlists</button>
                        <button id="deleteAccountButton" type="button"
                            class="cursor-pointer bg-red-600/80 hover:bg-red-600 border-0 rounded-4xl p-2 pl-10 pr-10 font-bold">Delete
                            Account</button>
                    </div>

                    <!-- logout button -->
                    <div class="mt-auto flex w-full justify-center">
                        <form action="/logout" method="POST">
                            <button type="submit"
                                class="cursor-pointer hover:bg-[#27B556] bg-[#27B556]/80 transition-colors delay-100 border-0 rounded-4xl p-2 pl-10 pr-10">LogOut</button>
                        </form>
                    </div>
                    <button id="cancelUserMenuButton" type="button"
                        class="cursor-pointer text-center w-full h-10 hover:bg-white/10 transition-colors delay-100 rounded-4xl text-[14px] font-bold mt-3">Cancel</button>
                </div>
            </div>
        </div>

        <!-- delete account menu -->
        <div id="deleteAccountMenu" class="fixed hidden w-screen h-screen z-1000">
            <div class="flex items-center justify-center w-full h-full bg-black/60">
                <div
                    class="relative z-10 border-2 border-black rounded-lg p-6 bg-[#181818] flex flex-col gap-5 justify-center h-72 w-100 min-w-0">

                    <p class="text-center text-xl font-bold text-red-300">Delete account?</p>
                    <p class="text-center text-sm text-gray-300">This will delete your account and playlists.</p>

                    <button id="confirmDeleteAccountButton" type="button"
                        class="text-center w-full h-10 hover:bg-red-600 bg-red-600/80 transition-colors delay-100 rounded-4xl text-[14px] font-bold cursor-pointer">Delete
                        Account</button>
                    <button id="cancelDeleteAccountButton" type="button"
                        class="text-center w-full h-10 hover:bg-white/10 transition-colors delay-100 rounded-4xl text-[14px] font-bold cursor-pointer">Cancel</button>
                </div>
            </div>
        </div>

        <!-- add to playList menu -->
        <div id="playlistMenu" class="fixed hidden w-screen h-screen z-1000">
            <div class="flex items-center justify-center w-full h-full bg-black/60">
                <div
                    class="relative z-10 border-2 border-black rounded-lg bg-[#181818] flex flex-col items-center justify-center h-72 w-100 px-12 py-10">

                    <h2 class="mb-8 text-center text-xl font-bold text-amber-50">Create a playlist</h2>

                    <div class="flex w-full justify-center border-0">
                        <form action="" class="flex w-full max-w-xl flex-col items-center">
                            <input id="playlistName" type="text" placeholder="playlist name"
                                class="mb-8 h-11 w-full bg-amber-50 text-black border-0 rounded-2xl px-5 text-base">
                            <button id="createPlaylist"
                                class="text-center w-full h-11 hover:bg-[#27B556] bg-[#27B556]/80 transition-colors delay-100 rounded-2xl text-base font-bold cursor-pointer"
                                type="button">Create playlist</button>
                            <button id="cancelPlaylistMenuButton" type="button"
                                class="text-center w-full h-10 hover:bg-white/10 transition-colors delay-100 rounded-4xl text-[14px] font-bold mt-3 cursor-pointer">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- add to song playlist menu -->
        <div id="songAddMenu" class="fixed hidden w-screen h-screen z-1000">
            <div class="flex items-center justify-center w-full h-full bg-black/60">
                <div
                    class="relative z-10 border-2 border-black rounded-lg p-6 bg-[#181818] flex flex-col gap-3 justify-start h-130 w-100 min-w-0">

                    <p class="text-sm font-bold text-amber-50 mb-4">Chose a song to add to the playlist</p>

                    <div class="flex min-h-0 flex-1 w-full max-w-full justify-center overflow-hidden border-0">
                        <form action="" id="allSongsMenu" class="flex min-h-0 h-full w-full max-w-full flex-col">
                            <div id="allSongsList"
                                class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden pr-2 scrollbar scrollbar-w-2 scrollbar-track-[#101010] scrollbar-thumb-amber-50/20 scrollbar-track-rounded-full scrollbar-thumb-rounded-full scrollbar-hover:scrollbar-thumb-amber-50/50 scrollbar-active:scrollbar-thumb-amber-50/70">
                            </div>
                            <p id="alertBox" class="w-full h-3 font-bold text-center text-sm mt-4"></p>
                            <!-- in js it will say with playlist to add to -->
                            <button
                                class="text-center w-full h-8 hover:bg-[#27B556] bg-[#27B556]/80 transition-colors delay-100 rounded-4xl text-[14px] font-bold mt-6 cursor-pointer"
                                type="submit">Add Songs to</button>
                            <button id="cancelSongAddButton" type="button"
                                class="text-center w-full h-8 hover:bg-white/10 transition-colors delay-100 rounded-4xl text-[14px] font-bold mt-3 cursor-pointer">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- remove songs menu -->
        <div id="songRemoveMenu" class="fixed hidden w-screen h-screen z-1000">
            <div class="flex items-center justify-center w-full h-full bg-black/60">
                <div
                    class="relative z-10 border-2 border-black rounded-lg p-6 bg-[#181818] flex flex-col gap-3 justify-start h-130 w-100 min-w-0">

                    <p class="text-sm font-bold text-amber-50 mb-4">Chose songs to remove</p>

                    <div class="flex min-h-0 flex-1 w-full max-w-full justify-center overflow-hidden border-0">
                        <form action="" id="removeSongsMenu" class="flex min-h-0 h-full w-full max-w-full flex-col">
                            <div id="removeSongsList"
                                class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden pr-2 scrollbar scrollbar-w-2 scrollbar-track-[#101010] scrollbar-thumb-amber-50/20 scrollbar-track-rounded-full scrollbar-thumb-rounded-full scrollbar-hover:scrollbar-thumb-amber-50/50 scrollbar-active:scrollbar-thumb-amber-50/70">
                            </div>
                            <p id="removeSongsAlert" class="w-full h-3 font-bold text-center text-sm mt-4"></p>
                            <button
                                class="text-center w-full h-8 hover:bg-[#27B556] bg-[#27B556]/80 transition-colors delay-100 rounded-4xl text-[14px] font-bold mt-6 cursor-pointer"
                                type="submit">Remove Songs</button>
                            <button id="cancelRemoveSongsButton" type="button"
                                class="text-center w-full h-8 hover:bg-white/10 transition-colors delay-100 rounded-4xl text-[14px] font-bold mt-3 cursor-pointer">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- remove playlists menu -->
        <div id="playlistRemoveMenu" class="fixed hidden w-screen h-screen z-1000">
            <div class="flex items-center justify-center w-full h-full bg-black/60">
                <div
                    class="relative z-10 border-2 border-black rounded-lg p-6 bg-[#181818] flex flex-col gap-3 justify-start h-130 w-100 min-w-0">

                    <p class="text-sm font-bold text-amber-50 mb-4">Chose playlists to remove</p>

                    <div class="flex min-h-0 flex-1 w-full max-w-full justify-center overflow-hidden border-0">
                        <form action="" id="removePlaylistsMenu" class="flex min-h-0 h-full w-full max-w-full flex-col">
                            <div id="removePlaylistsList"
                                class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden pr-2 scrollbar scrollbar-w-2 scrollbar-track-[#101010] scrollbar-thumb-amber-50/20 scrollbar-track-rounded-full scrollbar-thumb-rounded-full scrollbar-hover:scrollbar-thumb-amber-50/50 scrollbar-active:scrollbar-thumb-amber-50/70">
                            </div>
                            <p id="removePlaylistsAlert" class="w-full h-3 font-bold text-center text-sm mt-4"></p>
                            <button
                                class="text-center w-full h-8 hover:bg-[#27B556] bg-[#27B556]/80 transition-colors delay-100 rounded-4xl text-[14px] font-bold mt-6 cursor-pointer"
                                type="submit">Remove Playlists</button>
                            <button id="cancelRemovePlaylistsButton" type="button"
                                class="text-center w-full h-8 hover:bg-white/10 transition-colors delay-100 rounded-4xl text-[14px] font-bold mt-3 cursor-pointer">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <header class="border-0 rounded-2xl m-2 mb-0 grid grid-cols-3 items-center bg-[#181818]">
            <!-- left -->
            <div class="justify-self-start pl-2">
                <a href="/">
                    <img class="h-12 w-12 object-contain" src="assets/favicon.svg" alt="AudioHub" />
                </a>
            </div>

            <!-- center -->
            <div class="flex justify-center">
                <form class="w-full max-w-3xl" action="" method="post" id="searchBar">
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                            <svg class="h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none"
                                viewBox="0 0 24 24">
                                <path stroke="currentColor" stroke-linecap="round" stroke-width="2"
                                    d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
                            </svg>
                        </div>
                        <input id="search" class="border border-gray-400 rounded-4xl h-12 px-4 pl-9 w-full" type="text"
                            placeholder="Search for a song" />
                    </div>
                </form>
            </div>

            <!-- Right -->
            <div class="justify-self-end pr-2 z-110">
                <!-- add user profile popup -->
                <a onclick="toggleUserMenu()" class="cursor-pointer z-110">
                    <!-- user icon -->
                    <div class="border-0 rounded-4xl bg-[#27B556] w-12 h-12 flex items-center justify-center">
                        <img class="h-9 w-10 object-contain" src="assets/userIcon.png" alt="user" />
                    </div>
                </a>
            </div>
        </header>

        <main class="flex min-h-0 gap-2">
            <aside
                class="m-2 mr-0 w-72 shrink-0 min-h-0 max-h-[calc(100vh-11rem)] rounded-2xl bg-[#181818] overflow-y-auto scrollbar scrollbar-w-2 scrollbar-track-[#101010] scrollbar-thumb-amber-50/20 scrollbar-track-rounded-full scrollbar-thumb-rounded-full scrollbar-hover:scrollbar-thumb-amber-50/50 scrollbar-active:scrollbar-thumb-amber-50/70">

                <ul id="playListPlace" class="w-full">
                    <li class="p-4">
                        <button
                            class="text-center w-full h-8 hover:bg-[#27B556]/80 transition-colors delay-100 rounded-4xl text-[14px] font-bold cursor-pointer"
                            type="button" id="addPlaylist">
                            Add Playlist
                        </button>
                    </li>
                </ul>
            </aside>

            <section
                class="m-2 ml-0 flex-1 min-w-0 min-h-0 max-h-[calc(100vh-11rem)] rounded-2xl bg-[#181818] overflow-y-auto scrollbar scrollbar-w-2 scrollbar-track-[#101010] scrollbar-thumb-amber-50/20 scrollbar-track-rounded-full scrollbar-thumb-rounded-full scrollbar-hover:scrollbar-thumb-amber-50/50 scrollbar-active:scrollbar-thumb-amber-50/70">

                <ul id="songsList" class="m-2 pr-2">
                    <!-- songs are added in js -->
                </ul>
            </section>
        </main>

        <!-- audio player -->
        <footer class="m-2 mt-0 ">
            <div class="flex h-full w-full items-center gap-4 rounded-2xl px-4 py-3 bg-[#181818]">

                <!-- song info -->
                <div
                    class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-4xl text-[#28B556]">
                    <img id="songThumbnail" src="assets/noSongThumbnail.png" alt="Song thumbnail"
                        class="h-full w-full object-cover rounded-4xl">
                </div>

                <div class="min-w-0 shrink-0 w-32 md:w-3 lg:w-46">
                    <p id="playerTitle" class="truncate text-sm font-semibold text-amber-50">Choose a song</p>
                    <p id="playerChannel" class="truncate text-xs text-gray-400">Nothing playing</p>
                    <audio id="audioPlayer" class="hidden" preload="metadata" src=""></audio>
                </div>

                <!-- song controls -->
                <div class="flex min-w-0 flex-2 items-center gap-3">
                    <button id="previousSongButton" type="button"
                        class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-gray-300 transition hover:bg-white/10 hover:text-amber-50">
                        <i class="fa-solid fa-backward-step text-sm"></i>
                    </button>
                    <button id="playPauseButton" type="button"
                        class="flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-full bg-[#28B556] text-black transition hover:bg-[#31d267]">
                        <i id="playPauseIcon" class="fa-solid fa-play text-sm"></i>
                    </button>
                    <button id="nextSongButton" type="button"
                        class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-gray-300 transition hover:bg-white/10 hover:text-amber-50">
                        <i class="fa-solid fa-forward-step text-sm"></i>
                    </button>
                    <span id="currentTime" class="w-10 shrink-0 text-right text-xs text-gray-300">0:00</span>
                    <input id="progressBar" class="h-1 w-full cursor-pointer accent-[#28B556]" type="range" min="0"
                        max="100" value="0" step="0.1" />
                    <span id="durationTime" class="w-10 shrink-0 text-xs text-gray-300">0:00</span>
                </div>

                <!-- volume controls -->
                <div class="hidden items-center gap-3 md:flex">
                    <button id="muteButton" type="button"
                        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full text-gray-300 transition hover:bg-white/10 hover:text-amber-50">
                        <i id="volumeIcon" class="fa-solid fa-volume-high text-sm"></i>
                    </button>
                    <input id="volumeBar" class="h-1 w-24 cursor-pointer accent-[#28B556]" type="range" min="0" max="1"
                        value="1" step="0.01" />
                </div>
            </div>
        </footer>
    </div>
</body>

<script defer src="js/player.js"></script>
<script defer src="js/home.js"></script>
<script defer src="js/userMenu.js"></script>
<script defer src="js/playlists.js"></script>

</html>
